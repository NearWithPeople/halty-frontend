# Local dev (vite). Прокси в vite.config.ts: /cms → :1337, /api → :3001, /ws → :3001
VITE_STRAPI_URL=/cms
VITE_API_BASE_URL=/api
# Пусто = ws/wss на текущий host + VITE_WS_PATH
VITE_WS_URL=
VITE_WS_PATH=/ws
VITE_USE_STRAPI=false
# WebSocket / Node API (:3001). Включите true при npm run dev:all
VITE_ENABLE_NODE_WS=false

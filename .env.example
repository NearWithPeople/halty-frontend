# Mapbox Access Token (начинается с pk.eyJ...)
# Получите токен на https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ─── Локальная разработка → скопируйте в .env.development или .env ───
# Vite проксирует относительные пути (см. vite.config.ts)
# VITE_STRAPI_URL=/cms
# VITE_API_BASE_URL=/api
# VITE_WS_URL=
# VITE_WS_PATH=/ws
# VITE_USE_STRAPI=false
# VITE_ENABLE_NODE_WS=false   # true при npm run dev:all (Node :3001)

# ─── Production → Vercel → Settings → Environment Variables ───
# Те же имена. Файлы .env* на сборке Vercel не читаются.
# VITE_MAPBOX_ACCESS_TOKEN=
# VITE_STRAPI_URL=https://cms.halty.by
# VITE_API_BASE_URL=https://api.halty.by/api
# VITE_WS_URL=wss://api.halty.by/ws
# VITE_WS_PATH=/ws
# VITE_USE_STRAPI=false
# VITE_ENABLE_NODE_WS=false
